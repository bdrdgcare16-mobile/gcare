// Prisma schema for HRMS backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:Nishali@localhost:5432/SERV"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  name         String
  role         String
  phoneNumber  String?
  designation  String?
  shiftTiming  String?
  gender       String?
  department   String?
  reportingTo  String?
  dateOfJoining DateTime?
  
  // Direct relationships
  attendance   Attendance[]
  leaveRequests LeaveRequest[]
  payrolls     Payroll[]
  tasks        Task[]
  overtimes    Overtime[]
  permissions Permission[]
  checkInRequests CheckInRequest[]
  notifications Notification[]
  
  // Approval relationships
  approvedAttendances Attendance[] @relation("ApprovedBy")
  approvedLeaveRequests LeaveRequest[] @relation("ApprovedBy")
  approvedOvertimes Overtime[] @relation("ApprovedBy")
  approvedPermissions Permission[] @relation("ApprovedBy")
  approvedCheckIns CheckInRequest[] @relation("ApprovedBy")
  assignedTasks Task[] @relation("AssignedBy")
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([email])
  @@index([role])
  @@index([department])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String
  approvedBy Int?
  approvedByUser User? @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt DateTime?
  
  @@index([userId, date])
  @@index([approvedBy])
  @@index([status])
}

model CheckInRequest {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime
  checkInTime DateTime
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy Int?
  approvedByUser User? @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt DateTime?
  createdAt DateTime @default(now())
  
  @@index([userId, date])
  @@index([status])
  @@index([approvedBy])
}

model LeaveType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  requests  LeaveRequest[]
  
  @@index([name])
}

model LeaveRequest {
  id          Int        @id @default(autoincrement())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  leaveType   LeaveType  @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId Int
  startDate   DateTime
  endDate     DateTime
  status      String     @default("PENDING") // PENDING, APPROVED, REJECTED
  reason      String?
  approvedBy  Int?
  approvedByUser User? @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  createdAt   DateTime   @default(now())
  
  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedBy])
}

model Payroll {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  month     Int
  year      Int
  amount    Float
  details   String?
  createdAt DateTime @default(now())
  
  @@index([userId, month, year])
  @@unique([userId, month, year])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  priority  String   @default("medium") // low, medium, high
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([priority])
  @@index([isPinned])
  @@index([createdAt])
}

model Task {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  assignedBy  Int?
  assignedByUser User? @relation("AssignedBy", fields: [assignedBy], references: [id])
  assignedAt  DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedBy])
}

model Overtime {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime
  hours     Float
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy Int?
  approvedByUser User? @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt DateTime?
  createdAt DateTime @default(now())
  
  @@index([userId, date])
  @@index([status])
  @@index([approvedBy])
}

model Permission {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  date      DateTime
  startTime DateTime
  endTime   DateTime
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy Int?
  approvedByUser User? @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt DateTime?
  createdAt DateTime @default(now())
  
  @@index([userId, date])
  @@index([status])
  @@index([approvedBy])
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String
  message   String
  type      String   // TASK, LEAVE, ATTENDANCE, PAYROLL, ANNOUNCEMENT
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([createdAt])
}
