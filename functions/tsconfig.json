{
  "compilerOptions": {
    "module": "Node16",
    "isolatedModules": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "compileOnSave": true,
  "include": [
    "src", "src/types"
, "src/scripts"  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
