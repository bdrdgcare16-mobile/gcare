# Environment configuration for Firebase Functions
NODE_ENV=development
# IMPORTANT: Generate a secure JWT secret for production
# Use: openssl rand -base64 32se64-32
JWT_EXPIRES_IN=90d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Firebase configuration
APP_PROJECT_ID=your-project-id
APP_STORAGE_BUCKET=your-project-id.appspot.com
APP_PORT=5001

# Email configuration (update with your actual email service details)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false
